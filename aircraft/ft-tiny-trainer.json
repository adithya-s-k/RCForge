{
  "schemaVersion": 1,
  "id": "ft-tiny-trainer",
  "name": "FT Tiny Trainer \u00b7 Sport",
  "description": "FT Tiny Trainer with four-channel sport wing. Plan-derived dimensions, 193 g dry reference plus estimated 60 g battery. Estimated aerodynamics.",
  "provenance": {
    "plans": {
      "status": "sourced",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-Mini%20TinyTrainer-plans.pdf",
      "note": "Josh Bixler FT Tiny Trainer two-sheet plans. Sport wing on sheet 2; powered nose and conventional tail. 193 g without battery, 16 degree throws, 30% expo, minimum 5x3 prop, 250-size 2200 kv motor, 12 A ESC, 500-1000 mAh 3S, 2-4 5 g servos."
    },
    "geometry": {
      "status": "estimated",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-Mini%20TinyTrainer-plans.pdf",
      "note": "Vector/ruler readings: sport wing flat half span about 478.5 mm, root chord 139.5 mm, 32 mm aileron chord, rounded swept tips. Assembled approximation uses 5 degree dihedral, 953 mm projected span, 0.12566 m\u00b2 integrated wing area and 286 mm horizontal tail span. Powered nose and main fuselage overlap; 5 mm foam board. Not manufacturing CAD."
    },
    "mass": {
      "status": "estimated",
      "note": "Published dry reference 193 g plus assumed 60 g battery =253 g. Component allocations and box inertia approximate. Battery position solves nominal 35 mm aft leading-edge CG; CG target estimated from plan marker, not a flight-tested measurement. The assumed pack is carried under the powered nose; its outer envelope and longitudinal balance are not a measured installation."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Low-order coefficients and damping estimates for this size/class, not measured polars. No flight-log validation."
    },
    "propulsion": {
      "status": "estimated",
      "note": "5x3 prop diameter follows minimum recommendation. Static thrust 2.8 N, speed falloff and lag assumed; no motor/prop bench data."
    },
    "servos": {
      "status": "estimated",
      "note": "First-order 0.06 s control-surface response and 400 deg/s travel rate. Illustrative micro-servo response, not bench-measured."
    },
    "servoAssembly": {
      "status": "estimated",
      "note": "Individual servo masses are included once. Installation positions, horn ratios, travel setup and response lag are estimates. Battery position is recalculated to retain the reference longitudinal CG when the structural allocation changes. Servo speed is a no-load reference; hinge-load torque and dynamic servo current are not modeled."
    },
    "electricalEstimate": {
      "status": "estimated",
      "note": "3S 650 mAh pack, 0.065 ohm DC resistance and OCV curve are illustrative. Component battery mass remains unchanged. Static motor current is ideal induced power T^(3/2)/sqrt(2*rho*A), divided by an assumed 0.45 overall factor and nominal voltage, plus 0.2 A at full command. Thrust commands retain the prior estimated linear thrust curve. This is NOT a bench motor/prop test, efficiency map or endurance validation; replace with measured curves. Forward-flight current and servo loads are not resolved.",
      "url": "https://www.grc.nasa.gov/WWW/K-12/BGP/propth.html"
    },
    "foldedReconstruction": {
      "status": "estimated",
      "note": "Sport-wing tips taper toward the trailing edge; ailerons occupy measured 31 to 373 mm outboard span, rather than reaching the tips. Tail outlines/hinges are rotated from sheet-2 vectors; root-tab details omitted. Main fuselage and removable power nose split the original 49 g body allocation. Tail split retains 20 g. Fold heights, assembled stations and individual mass distributions remain estimates.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-Mini%20TinyTrainer-plans.pdf"
    }
  },
