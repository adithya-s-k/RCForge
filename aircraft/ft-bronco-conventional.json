{
  "schemaVersion": 1,
  "id": "ft-bronco-conventional",
  "name": "FT Bronco · Conventional",
  "description": "Flite Test Bronco with a horizontal elevator, twin fixed fins and differential motor thrust for yaw. High-mounted wing over the cabin and booms. Reconstructed from plans and photos; flight coefficients are estimates.",
  "provenance": {
    "dimensions": {
      "status": "sourced",
      "note": "Published span 1.086 m and wing area 0.208 m². The procedural folded wing and assembly reconstruction use the separate geometry assumptions below.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "mass": {
      "status": "sourced",
      "note": "PDF specifies 640 g without battery and reference AUW 830 g; uses estimated 190 g battery. Reference mass is retained with three 9 g servos and an estimated 39 g conventional tail; this variant has not been weighed.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "cg": {
      "status": "calculated",
      "note": "Battery position calculated to balance at published 51 mm aft leading edge. This is a simulated setup, not a measured battery location.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Low-order quasi-steady surface model, estimated polars, damping and stall. No flight-test calibration."
    },
    "propulsion": {
      "status": "estimated",
      "note": "Two 4.2 N static thrust sources with approximate speed falloff. No measured motor/propeller curves."
    },
    "geometry": {
      "status": "estimated",
      "note": "Plan-derived procedural reconstruction: 192 mm wing chord, approximately 61% outer-span ailerons, 658 mm booms, 63 mm fuselage core width; Conventional tail parts 13/14, sheet 3. Folded assembly locations and nose cross-sections inferred from build photos. Not a manufacturing template."
    },
    "servos": {
      "status": "estimated",
      "note": "First-order 0.06 s control-surface response and 400 deg/s travel rate. Illustrative micro-servo response, not bench-measured."
    },
    "servoAssembly": {
      "status": "estimated",
      "note": "Individual servo masses are included once. Installation positions, horn ratios, travel setup and response lag are estimates. Battery position is recalculated to retain the reference longitudinal CG when the structural allocation changes. Servo speed is a no-load reference; hinge-load torque and dynamic servo current are not modeled."
    },
    "electricalEstimate": {
      "status": "estimated",
      "note": "3S 2200 mAh pack, 0.04 ohm DC resistance and OCV curve are illustrative. Component battery mass remains unchanged. Static motor current is ideal induced power T^(3/2)/sqrt(2*rho*A), divided by an assumed 0.45 overall factor and nominal voltage, plus 0.2 A at full command. Thrust commands retain the prior estimated linear thrust curve. This is NOT a bench motor/prop test, efficiency map or endurance validation; replace with measured curves. Forward-flight current and servo loads are not resolved.",
      "url": "https://www.grc.nasa.gov/WWW/K-12/BGP/propth.html"
    },
    "noseReconstruction": {
      "status": "estimated",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf",
      "note": "Sheet 1 Nose part 05: right-side cut outline runs Y=139.420 to 712.960 pt; inner fold station X=1344.86 pt. Its 573.54 pt projected length is 202.33 mm and rear height 371.64 pt is 131.66 mm. Sampled curvature replaces generic pointed loft. Parallel 68 mm width follows the 192.84 pt core fold separation (including board overlap); rear-core transition and X/Z registration remain photo-guided estimates. Nose apex retained near body X=327 mm. Cockpit paint and hatch markings are estimated from original assembly photographs. Fuselage mass and mass center retained; updated outer envelope changes its box-inertia estimate."
    },
    "motorInstallation": {
      "status": "estimated",
      "note": "Motor housing geometry now uses the motor component center and dimensions, instead of independent renderer constants. Housing stations are aligned with the existing reconstructed mount/prop assembly; housing dimensions and mass allocations remain estimates, not bench measurements. Battery moves aft to retain the same mass-weighted CG. Component box inertia changes with these revised dimensions and stations."
    },
    "propellerMass": {
      "status": "estimated",
      "note": "Separate 6 g mass entry per propeller, reallocated from the existing estimated left-nacelle, right-nacelle structural allocation. Published dry mass, existing motor masses, total aircraft mass and longitudinal CG are retained; battery station is rebalanced. Prop dimensions/inertia and the allocation are estimates, not weighed components. Propeller center follows the reconstructed rotor disk. This allows replacement of both motor and prop masses with a matching performance curve without adding the old prop mass again."
    },
    "wingMount": {
      "status": "estimated",
      "url": "https://www.flitetest.com/articles/ft-bronco-build",
      "note": "Assembly correction from the build photographs: the wing underside sits above the fuselage and boom saddles, not through the cockpit. Wing reference plane raised 23 mm; mass centers, wing servos and tip contacts follow it. Fuselage/boom/pod upper stations meet the 2-degree-incidence lower wing skin; bands and dowels add no separate mass. Vertical registration and installed part masses remain estimates. Longitudinal CG and 830 g reference mass are retained."
    },
    "conventionalTail": {
      "status": "calculated",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf",
      "note": "Sheet 3 H-tail part 14: span X=868.88..1937.96 pt (377.15 mm), chord Y=456.76..783.76 pt (115.36 mm), hinge Y=562.90 pt. Fin part 13 polygon rotated by 17.74 degrees to its root fold; mounting tabs omitted. H-tail slots set 343.03 mm boom spacing. Tail root stations and vertical installation are photo-guided estimates. Two unhinged fixed fins, one elevator servo and differential motor yaw match the plan topology; no moving rudders are authored. Fin orientation places the long root fillet forward and the upper fin swept aft, as in the conventional assembly photograph."
    },
    "tailMassAndAero": {
      "status": "estimated",
      "note": "The conventional tail uses an estimated 13 g stabilizer and two 13 g fins, with one 9 g elevator servo instead of two ruddervator servos. This preserves the shared 830 g reference total, not a weighed conventional variant. Battery is rebalanced to 51 mm CG. Tail areas and mass centers are integrated from traced outlines; inertia uses component cuboids. Tail lift slopes use 2*pi/(1+2/(0.8*AR)); drag, effectiveness and rate damping are estimates, not measured or flight calibrated. Battery lateral placement is calculated to balance the single elevator servo on the left boom; it is not a measured installation."
    }
  },
