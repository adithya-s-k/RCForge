{
  "schemaVersion": 1,
  "id": "bronco-tri-vtol",
  "name": "Bronco · Tricopter VTOL",
  "description": "Experimental Bronco-sized tricopter: two RDS3115MG front conversion servos and a separate MG996R rear yaw mount. Ideal-state hover/cruise assistance; uncalibrated build.",
  "provenance": {
    "dimensions": {
      "status": "sourced",
      "note": "Published span 1.086 m and wing area 0.208 m². The procedural folded wing and assembly reconstruction use the separate geometry assumptions below.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "geometry": {
      "status": "estimated",
      "note": "Plan-derived procedural reconstruction: 192 mm wing chord, approximately 61% outer-span ailerons, 658 mm booms, 63 mm fuselage core width; A-tail sheet 3. Folded assembly locations and nose cross-sections inferred from build photos. Not a manufacturing template. Rear motor force acts on its longitudinal hinge at Z=13 mm; housing center is 28 mm above it. Rotation moves the housing along its thrust line; component inertia stays at the authored neutral configuration."
    },
    "tail": {
      "status": "estimated",
      "note": "A-tail panel flat span approximately 254 mm per side and chord 102 mm measured from PDF sheet 3 ruler. 45 degree fold remains an assembly estimate; yields 359 mm boom spacing and 180 mm apex height. Ruddervator effectiveness and inertia distribution remain estimates."
    },
    "noseReconstruction": {
      "status": "estimated",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf",
      "note": "Sheet 1 Nose part 05: right-side cut outline runs Y=139.420 to 712.960 pt; inner fold station X=1344.86 pt. Its 573.54 pt projected length is 202.33 mm and rear height 371.64 pt is 131.66 mm. Sampled curvature replaces generic pointed loft. Parallel 68 mm width follows the 192.84 pt core fold separation (including board overlap); rear-core transition and X/Z registration remain photo-guided estimates. Nose apex retained near body X=327 mm. Cockpit paint and hatch markings are estimated from original assembly photographs. Fuselage mass and mass center retained; updated outer envelope changes its box-inertia estimate."
    },
    "controls": {
      "status": "sourced",
      "note": "12 degree reference throws; inverted-V pitch/yaw mixing and aerodynamic effectiveness estimated. No flight-test calibration.",
      "url": "https://www.flitetest.com/articles/ft-bronco-build"
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Uncalibrated Bronco analytical wing/tail coefficients retained as an explicit starting approximation. No measured VTOL interference, rotor-wing downwash, dynamic transition, tilt gyroscopic or flight data; rigid inertia fixed at declared part positions."
    },
    "propulsion": {
      "status": "sourced",
      "note": "Motor mass and dimensions and 11.1 V / 1045 thrust-current-RPM samples from EMAX. Command is estimated RPM/max RPM, not measured PWM. Propeller mass, response time, torque ratio and air density are estimated. Robu datasheet describes an older 920KV variant; do not treat its maximum-thrust headline as this curve. This motor is an assumed installable option, not identified from the photograph.",
      "url": "https://emaxmodel.com/collections/mt-series/products/emax-mt2213-935kv-multicopter-brushless-motor"
    },
    "mass": {
      "status": "estimated",
      "note": "Individual ledger: baseline Bronco structure retained, three 53 g motor / 8 g prop packages, two 60 g RDS3115MG and one provisional 55 g MG996R, four 9 g surface servos, 190 g battery; separate ESCs, receiver, wiring, BEC, controller, brackets, beam and skids. Published 830 g Bronco mass is NOT the mass of this conversion. Installation hardware and structure allocation are unweighed estimates."
    },
    "cg": {
      "status": "calculated",
      "note": "CG and full inertia tensor are computed from the part ledger. Battery is placed forward in the nose to reduce rear rotor load. Positions are estimated from the reference layout, not measured build stations. Move parts to adjust balance; the published Bronco 51 mm CG is a reference, not a guaranteed VTOL target."
    },
    "frontServos": {
      "status": "sourced",
      "note": "RDS3115MG retailer: 60 g, 180°, 0.14 s/60° at 6 V. Front mounts use a 0–90° conversion with a slower configured transition rate. Torque capability under propeller load, mount rigidity and servo current are not verified.",
      "url": "https://robocraze.com/products/rds3115mg-15kg-large-torque-180-degree"
    },
    "rearServo": {
      "status": "estimated",
      "note": "Close-up suggests an MG996R alongside a printed longitudinal hinge on a wood beam. Provisional manufacturer mass 55 g and 0.15 s/60° at 6 V; configured rear yaw lean ±20°. Actual servo identity, horn geometry and bearings need measurement.",
      "url": "https://towerpro.com.tw/product/mg996r/"
    },
    "electrical": {
      "status": "estimated",
      "note": "3S 2200 mAh / 190 g battery with illustrative OCV, 0.04 ohm resistance and 0.6 A constant avionics allowance. Motor thrust/current use the sourced static EMAX table. No dynamic servo current, BEC heating, flight-speed efficiency or measured endurance model."
    },
    "vtolControl": {
      "status": "estimated",
      "note": "Independent ideal-state hover/cruise controller inspired by ArduPilot tricopter conventions. Front motors tilt together for conversion; rear rotor leans sideways for yaw. No ArduPilot firmware, sensors, EKF or real-world control tuning is reproduced. Hover support and conversion depend on available modeled thrust.",
      "url": "https://ardupilot.org/plane/docs/guide-tilt-rotor.html"
    },
    "controlSurfaceServos": {
      "status": "estimated",
      "note": "Four 9 g surface servos, 0.06 s lag, linkage ratios and 12° throws are illustrative. Servo no-load speed limits travel; aerodynamic hinge load, backlash and linkage flex are not modeled."
    },
    "cruiseTrim": {
      "status": "calculated",
      "note": "Calm sea-level longitudinal equilibrium at 14 m/s with this mass ledger: pitch 2.297°, elevator command +0.30763. Recalculate after moving parts or changing surfaces. Not a measured flight trim."
    }
  },
