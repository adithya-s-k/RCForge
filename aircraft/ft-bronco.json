{
  "schemaVersion": 1,
  "id": "ft-bronco",
  "name": "FT Bronco",
  "description": "Twin-motor foamboard FT Bronco with inverted-V (A-tail) ruddervators, matching the supplied build reference. Estimated flight model.",
  "provenance": {
    "dimensions": {
      "status": "sourced",
      "note": "Published span 1.086 m and wing area 0.208 m\u00b2. The procedural folded wing and assembly reconstruction use the separate geometry assumptions below.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "mass": {
      "status": "sourced",
      "note": "PDF specifies 640 g without battery and reference AUW 830 g; uses estimated 190 g battery. Four 9 g servo allocation, other individual component masses estimated.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "cg": {
      "status": "calculated",
      "note": "Battery position calculated to balance at published 51 mm aft leading edge. This is a simulated setup, not a measured battery location.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    },
    "controls": {
      "status": "sourced",
      "note": "12 degree reference throws; inverted-V pitch/yaw mixing and aerodynamic effectiveness estimated. No flight-test calibration.",
      "url": "https://www.flitetest.com/articles/ft-bronco-build"
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Low-order quasi-steady surface model, estimated polars, damping and stall. No flight-test calibration."
    },
    "propulsion": {
      "status": "estimated",
      "note": "Two 4.2 N static thrust sources with approximate speed falloff. No measured motor/propeller curves."
    },
    "geometry": {
      "status": "estimated",
      "note": "Plan-derived procedural reconstruction: 192 mm wing chord, approximately 61% outer-span ailerons, 658 mm booms, 63 mm fuselage core width; A-tail sheet 3. Folded assembly locations and nose cross-sections inferred from build photos. Not a manufacturing template."
    },
    "tail": {
      "status": "estimated",
      "note": "A-tail panel flat span approximately 254 mm per side and chord 102 mm measured from PDF sheet 3 ruler. 45 degree fold remains an assembly estimate; yields 359 mm boom spacing and 180 mm apex height. Ruddervator effectiveness and inertia distribution remain estimates."
    },
    "servos": {
      "status": "estimated",
      "note": "First-order 0.06 s control-surface response and 400 deg/s travel rate. Illustrative micro-servo response, not bench-measured."
    },
    "servoAssembly": {
      "status": "estimated",
      "note": "Individual servo masses are included once. Installation positions, horn ratios, travel setup and response lag are estimates. Battery position is recalculated to retain the reference longitudinal CG when the structural allocation changes. Servo speed is a no-load reference; hinge-load torque and dynamic servo current are not modeled."
    },
    "electricalEstimate": {
      "status": "estimated",
      "note": "3S 2200 mAh pack, 0.04 ohm DC resistance and OCV curve are illustrative. Component battery mass remains unchanged. Static motor current is ideal induced power T^(3/2)/sqrt(2*rho*A), divided by an assumed 0.45 overall factor and nominal voltage, plus 0.2 A at full command. Thrust commands retain the prior estimated linear thrust curve. This is NOT a bench motor/prop test, efficiency map or endurance validation; replace with measured curves. Forward-flight current and servo loads are not resolved.",
      "url": "https://www.grc.nasa.gov/WWW/K-12/BGP/propth.html"
    },
    "foldedReconstruction": {
      "status": "estimated",
      "note": "Wing skin has 5 mm board and estimated 21 mm folded height. A-tail central trailing-edge relief and hinge station follow sheet 3. Nacelles split 40 g from the original fuselage allocation; boom taper and component stations use estimated folded geometry. Servo positions now follow the wing and rear booms; total mass and 51 mm CG target retained. Battery height is estimated to fit beneath the sloping nose skin; it is not a measured installation.",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT%20Bronco%20v1.0%20Full-Size.pdf"
    }
  },
