{
  "schemaVersion": 1,
  "id": "ft-22-raptor",
  "name": "FT-22 Raptor",
  "description": "Flite Test foamboard park jet. 649 mm plan-derived span, two mixed elevons and a 9-inch pusher. 235 g dry reference plus an estimated 85 g battery. Estimated flight model.",
  "provenance": {
    "plans": {
      "status": "sourced",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-22-plans.pdf",
      "note": "Original two-sheet FT-22 plans by Josh Bixler, Flite Test (2014): 235 g without battery, 1300 KV 24 g motor, 9x4.7 prop, 10-25 A ESC, 500-1300 mAh 3S, two 9 g servos. This is the original FT-22, not the Mighty Mini or a turbine/EDF F-22."
    },
    "dimensions": {
      "status": "estimated",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-22-plans.pdf",
      "note": "Original PDF ruler rectangles are 72.000 pt per inch (sheet 1, X 231.474 to 303.474); centimetre bars are 28.346-28.348 pt. Using 0.0254/72 metres per point gives 649.285 mm for the traced span Y 36.906 to 1877.3987. This replaces the inconsistent store metric 635 mm (the same listing says 25.5 inches). Main plate, separate elevons, fins and folded body side profile use this ruler scale. Hardware dimensions and 5 mm board thickness do not scale. Body nose registration retains the 400 mm target within the published 394-406 mm range; assembly widths, registration and 18 degree fin cant remain estimates. Aerodynamic centers are calculated polygon quarter-chord estimates, not measured pressure centers."
    },
    "mass": {
      "status": "estimated",
      "note": "Dry allocations retain 235 g and the battery 85 g. Structural positions follow reconstructed polygon centroids; body mass center and cuboid inertias remain approximations. Battery position balances the 400 mm nose-to-CG target; verify installation against a physical build."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Separate finite-wing lifting plate halves, mixed elevons and two fixed canted fins. Area comes from reconstructed polygons; aerodynamic centers, lift slopes, drag, damping and control effectiveness are estimates. No rudder channel or active stabilization. Delta vortex lift, deep stall, prop interference and actual flight behavior remain unvalidated."
    },
    "controls": {
      "status": "estimated",
      "url": "https://www.flitetest.com/articles/ft-22-raptor-build",
      "note": "Two elevons mix pitch and roll in RCForge; transmitter should send unmixed aircraft axes. Maximum 40 degree throw follows plan; 0.06 s and 400 deg/s servo response estimated. No physical rudder; yaw input has no direct authority."
    },
    "propulsion": {
      "status": "estimated",
      "note": "9x4.7-inch pusher in the plan motor opening with estimated 4.8 N static thrust, 24 m/s falloff and 90 ms response. Electrical current is an induced-power estimate, not bench data."
    },
    "servoAssembly": {
      "status": "estimated",
      "note": "Individual positional servos replace the previous combined equipment allocation without changing total mass or longitudinal CG. Positions, horn ratios, travel setup and response lag are estimates. Servo speed is a no-load reference; torque under aerodynamic hinge load and dynamic servo current are not modeled."
    },
    "initialControlTravel": {
      "status": "estimated",
      "note": "Published 40 degree throws are available through +/-50 degree servo travel and 10/12.5 mm horn ratio. Reducing travel reduces trim and recovery authority as well as sensitivity. Linkage, no-load speed and aerodynamic control effectiveness remain estimates; use the component editor to reproduce a measured setup."
    },
    "electricalEstimate": {
      "status": "estimated",
      "note": "3S 1000 mAh pack, 0.07 ohm DC resistance and OCV curve are illustrative. Component battery mass remains unchanged. Static motor current is ideal induced power T^(3/2)/sqrt(2*rho*A), divided by an assumed 0.45 overall factor and nominal voltage, plus 0.2 A at full command. Thrust commands retain the prior estimated linear thrust curve. This is NOT a bench motor/prop test, efficiency map or endurance validation; replace with measured curves. Forward-flight current and servo loads are not resolved.",
      "url": "https://www.grc.nasa.gov/WWW/K-12/BGP/propth.html"
    },
    "batteryProduct": {
      "status": "sourced",
      "note": "Orange 3S 1000 mAh 30C product mass 85 g and 75 x 34 x 17 mm from indexed Robu specifications. Resistance/OCV/current remain estimates. Does not establish that this battery was used in the original Flite Test build.",
      "url": "https://robu.in/product/orange-1000mah-3s-30c60c-lithium-polymer-battery-pack-lipo/"
    },
    "foldedAssembly": {
      "status": "estimated",
      "note": "Nose side profile, separate elevon outline and fixed fin outline follow full-size vector plans. Foam intake floor/walls and side rails use estimated folded registration, with a prop-clearance interruption. Their 20 g allocation is removed from the original 60 g fuselage allocation; total structure mass is unchanged. Canopy top color is a visual marking, not a mass component."
    },
    "planScale": {
      "status": "calculated",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-22-plans.pdf",
      "note": "Printed-inch ruler establishes 72 pt/in, rather than scaling the outline to a conflicting store dimension. Structural span/chords/area/centers and inertia follow the corrected drawing scale. The fixed 9-inch prop now clears the main-plate slot in the reconstructed geometry; this is a geometry check, not a real-build clearance guarantee. The published 235 g dry mass and assumed 85 g battery remain. Battery is rebalanced to retain CG; no measured aerodynamic or propulsion curves were added."
    }
  },
