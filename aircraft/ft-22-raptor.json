{
  "schemaVersion": 1,
  "id": "ft-22-raptor",
  "name": "FT-22 Raptor",
  "description": "Flite Test foamboard park jet. 635 mm span, two mixed elevons and a 9-inch pusher. 235 g dry reference plus an estimated 85 g battery. Estimated flight model.",
  "provenance": {
    "plans": {
      "status": "sourced",
      "url": "https://s3.amazonaws.com/plans.flitetest.com/stonekap/FT-22-plans.pdf",
      "note": "Original two-sheet FT-22 plans by Josh Bixler, Flite Test (2014): 235 g without battery, 1300 KV 24 g motor, 9x4.7 prop, 10-25 A ESC, 500-1300 mAh 3S, two 9 g servos. This is the original FT-22, not the Mighty Mini or a turbine/EDF F-22."
    },
    "dimensions": {
      "status": "estimated",
      "url": "https://store.flitetest.com/ft-22-mkr2/",
      "note": "Manufacturer lists span as both 25.5 inches and 635 mm; these disagree. This model uses 635 mm, scales simplified sheet-1 wing outline to it, and uses 400 mm nose-to-CG within the published 394-406 mm range. Assembly nose/fin/elevon stations and fold heights are approximations checked against build photos, not manufacturing CAD. Wing-root leading edge is estimated 90 mm ahead of CG; wing/tail assembly placement gives a positive modeled static margin. This is an assembly estimate, not a measured stability derivative."
    },
    "mass": {
      "status": "estimated",
      "note": "Dry allocations sum to published 235 g; assumed 85 g 3S 1000 mAh pack gives 320 g. Component positions and cuboid inertia estimated. Battery position solves CG at datum X=0, 400 mm behind nose. No measured component inertias."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Separate finite-wing lifting plate halves, mixed elevons and two fixed canted fins. Area comes from reconstructed polygons; aerodynamic centers, lift slopes, drag, damping and control effectiveness are estimates. No rudder channel or active stabilization. Delta vortex lift, deep stall, prop interference and actual flight behavior remain unvalidated."
    },
    "controls": {
      "status": "estimated",
      "url": "https://www.flitetest.com/articles/ft-22-raptor-build",
      "note": "Two elevons mix pitch and roll in RCForge; transmitter should send unmixed aircraft axes. Maximum 40 degree throw follows plan; 0.06 s and 400 deg/s servo response estimated. No physical rudder; yaw input has no direct authority."
    },
    "propulsion": {
      "status": "estimated",
      "note": "9x4.7-inch pusher with assumed 4.8 N static thrust, 24 m/s zero-thrust speed and 90 ms response. No measured motor/prop thrust-current table, electrical depletion, P-factor or propeller gyroscopic model."
    }
  },
